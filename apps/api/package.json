{
  "name": "@tierforge/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "tsx tests/require-test-database.ts \u0026\u0026 vitest run tests/database.test.ts tests/jobs.database.test.ts tests/enrichment.database.test.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^5.0.3"
  }
}
