{
  "name": "tierforge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "\u003e=24.0.0 \u003c25",
    "pnpm": "\u003e=12 \u003c13"
  },
  "scripts": {
    "setup": "pnpm install",
    "dev": "pnpm --parallel --filter @tierforge/web --filter @tierforge/api dev",
    "dev:web": "pnpm --filter @tierforge/web dev",
    "dev:api": "pnpm --filter @tierforge/api dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:db": "pnpm --filter @tierforge/api test:db",
    "test:bonus": "pnpm build \u0026\u0026 pnpm --filter @tierforge/api test:bonus",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @tierforge/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
