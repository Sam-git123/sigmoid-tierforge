# Copy to .env at the repository root. Never commit .env.
# Local-only example credentials: replace for any shared deployment.
DATABASE_URL=postgresql://tierforge:tierforge_local@127.0.0.1:5432/tierforge
POSTGRES_USER=tierforge
POSTGRES_PASSWORD=tierforge_local
POSTGRES_DB=tierforge
POSTGRES_PORT=5432

API_PORT=3001
LOG_LEVEL=info
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=5000

# CSV limits: 10 MiB and 10,000 stores per upload.
CSV_MAX_BYTES=10485760
CSV_MAX_ROWS=10000

# Enrichment worker, retry, lease-recovery, and systemic-failure settings.
ENRICHMENT_API_BASE_URL=http://127.0.0.1:8000
WORKER_CONCURRENCY=6
ENRICHMENT_MAX_RPS=5
MIN_DISPATCH_INTERVAL_MS=220
ENRICHMENT_TIMEOUT_MS=8000
MAX_ATTEMPTS=5
LEASE_DURATION_MS=20000
LEASE_REAPER_INTERVAL_MS=1000
RETRY_BASE_MS=1000
RETRY_CAP_MS=30000
SYSTEMIC_FAILURE_STREAK=30
MAX_UPSTREAM_COOLDOWN_MS=120000

# Public browser setting; never put secrets in VITE_* variables.
# Vite proxies /api to API_PORT; production needs the same-origin /api reverse proxy.
VITE_API_BASE_URL=/api

# Optional: enable isolated-schema integration tests via pnpm test.
# Uses a dedicated random schema, never truncates existing application tables.
# TEST_DATABASE_URL=postgresql://tierforge:tierforge_local@127.0.0.1:5432/tierforge

